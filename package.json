{
  "name": "@wirecat/tg-cli",
  "version": "0.103.0",
  "description": "A local command line interface for a personal Telegram account, built for agents and scripts",
  "mcpName": "dev.wirecat/tg-cli",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/tg-cli.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.28.8",
  "bin": {
    "tg": "dist/bin/tg.js"
  },
  "files": [
    "dist",
    "skills",
    "scenarios",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "install",
    "spec/bot/LICENSE"
  ],
  "scripts": {
    "build": "tsc --build --force && cli-dev bundle --bin dist/bin/tg.js --external \"@mtcute/*\" --external undici",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:matrix": "vitest run >/dev/null && tsc --build --force >/dev/null && pnpm test:matrix:check",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "smoke:node": "node --experimental-strip-types scripts/smoke.ts",
    "docs:check": "node --experimental-strip-types scripts/docs-check.ts && cspell --no-progress --no-summary README.md 'docs/*.md' && rumdl check --config config/wirecat/rumdl.toml --disable MD028 README.md docs/*.md",
    "parity:check": "pnpm build && node dist/bin/tg.js commands --json | cli-core-parity tg && node dist/bin/tg.js commands --json | cli-core-parity tg --pages README.md docs/*.md",
    "smoke:live": "pnpm build && node --experimental-strip-types scripts/smoke-live.ts",
    "release:check": "pnpm build && node --experimental-strip-types scripts/release-check.ts",
    "version:check": "cli-dev version",
    "version:sync": "cli-dev version --sync",
    "generate": "pnpm bot:generate && pnpm build && node --experimental-strip-types scripts/commands.ts",
    "probe:random-id": "pnpm build && node --experimental-strip-types scripts/probe-random-id.ts",
    "probe:sessions": "pnpm build && node --experimental-strip-types scripts/live-two-processes.ts",
    "probe:sessions-parallel": "pnpm build && node --experimental-strip-types scripts/live-two-processes.ts --parallel",
    "spike:live": "bin/tg-spike-live",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "postinstall": "node install/postinstall.mjs",
    "bot:generate": "node --experimental-strip-types scripts/bot/generate.ts",
    "bot:generate:check": "node --experimental-strip-types scripts/bot/generate.ts --check",
    "check:agent-docs": "pnpm build && node --experimental-strip-types scripts/check-agent-docs.ts",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md",
    "ci:quick": "pnpm typecheck && pnpm build && pnpm lint:commands",
    "contracts:check": "cli-contract contracts/plan.json",
    "contracts:upgrade": "pnpm --dir contracts/previous install --frozen-lockfile --ignore-scripts && cli-contract contracts/upgrade.json && cli-contract contracts/legacy-store.json",
    "security:no-leak": "cli-testing security no-leak . contracts/no-leak.json",
    "lint:commands": "cli-dev lint --cli dist/bin/tg.js",
    "test:matrix:check": "cli-dev test-matrix --program dist/whole-program.js --untested scripts/test-matrix-untested.ts --name tg --check && git diff --exit-code -- docs/dev/test-matrix.md",
    "generate:check": "pnpm bot:generate:check && pnpm build && node --experimental-strip-types scripts/commands.ts && git diff --exit-code -- docs/commands.md",
    "package:check": "node --experimental-strip-types scripts/release-check.ts --package-only"
  },
  "dependencies": {
    "@mtcute/node": "0.32.7",
    "@wirecat/cli-base": "0.65.0",
    "@wirecat/cli-core": "0.469.0",
    "commander": "15.0.0",
    "undici": "8.12.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cspell/dict-en-gb": "5.0.38",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.4",
    "@napi-rs/canvas": "1.0.13",
    "@types/node": "^22.20.5",
    "@valibot/to-json-schema": "1.8.0",
    "@vitest/coverage-v8": "5.0.5",
    "@wirecat/cli-testing": "0.5.3",
    "cspell": "10.4.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "rumdl": "^0.3.0",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
}
