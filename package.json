{
  "name": "@leemour/tg-cli",
  "version": "0.9.0",
  "description": "A local command line interface for a personal Telegram account, built for agents and scripts",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/tg-cli.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "tg": "dist/bin/tg.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:matrix": "vitest run >/dev/null && tsc --build --force >/dev/null && node --experimental-strip-types scripts/test-matrix.ts --check",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; node --experimental-strip-types scripts/slow-tests.ts",
    "smoke:bun": "bun run scripts/smoke.ts",
    "docs:check": "node --experimental-strip-types scripts/docs-check.ts",
    "probe:random-id": "pnpm build && node --experimental-strip-types scripts/probe-random-id.ts",
    "spike:live": "bin/tg-spike-live",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact ."
  },
  "dependencies": {
    "@leemour/cli-core": "0.8.0",
    "@leemour/cli-messaging": "0.42.0",
    "@mtcute/node": "0.32.3",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
