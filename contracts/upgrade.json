{
  "command": "node",
  "args": ["../dist/bin/tg.js"],
  "previous": {},
  "fixtures": [
    {
      "path": "TG/CONFIG/config.json",
      "text": "{\"defaults\": {\"limit\": 7}, \"profiles\": {\"contract\": {}}}"
    },
    {
      "path": "import.json",
      "text": "{\"synthetic\": true, \"account\": {\"id\": \"601\", \"name\": \"Contract\", \"username\": null}, \"people\": [{\"id\": \"11\", \"name\": \"Synthetic Example\", \"username\": null}], \"chats\": [{\"id\": \"7\", \"title\": \"Synthetic Contract Group\", \"kind\": \"group\", \"unreadCount\": 0, \"lastMessageAt\": null, \"participantsCount\": null}], \"messages\": [{\"id\": \"101\", \"chatId\": \"7\", \"senderId\": \"11\", \"senderName\": \"Synthetic Example\", \"timestamp\": \"2026-10-01T10:00:00Z\", \"editedAt\": null, \"text\": \"wirecat-synthetic-message-canary\", \"outgoing\": false}]}"
    }
  ],
  "canaries": ["wirecat-synthetic-message-canary"],
  "artifacts": ["TG/STATE/runs"],
  "cases": [
    {
      "id": "seed-previous-store",
      "args": ["contract", "--json", "store", "import", "import.json", "--yes"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "previous": true,
      "json": {
        "item": {
          "imported": true
        }
      }
    },
    {
      "id": "previous-store-data",
      "args": ["contract", "--offline", "--json", "--record", "messages", "list", "7"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "previous": true,
      "allowSensitiveOutput": true,
      "json": {
        "items": [
          {
            "id": "101",
            "text": "wirecat-synthetic-message-canary"
          }
        ]
      }
    },
    {
      "id": "candidate-store-migrate",
      "args": ["contract", "store", "migrate", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "diagnostic": "4 terms\n"
    },
    {
      "id": "candidate-store-first-read",
      "args": ["contract", "--offline", "--json", "--record", "messages", "list", "7"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "previous": false,
      "allowSensitiveOutput": true,
      "json": {
        "items": [
          {
            "id": "101",
            "text": "wirecat-synthetic-message-canary"
          }
        ]
      }
    },
    {
      "id": "candidate-store-data",
      "args": ["contract", "--offline", "--json", "--trace", "--record", "messages", "list", "7"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "previous": false,
      "allowSensitiveOutput": true,
      "json": {
        "items": [
          {
            "id": "101",
            "text": "wirecat-synthetic-message-canary"
          }
        ]
      }
    },
    {
      "id": "task-add",
      "args": [
        "contract",
        "--json",
        "--record",
        "tasks",
        "add",
        "msg:telegram/601/7/101",
        "--type",
        "promise",
        "--category",
        "money"
      ],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "capture": {
        "task": "/item/id"
      },
      "json": {
        "item": {
          "state": "open"
        }
      },
      "allowSensitiveOutput": true
    },
    {
      "id": "task-list",
      "args": ["contract", "--json", "--trace", "--record", "tasks", "list", "state:open"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "allowSensitiveOutput": true,
      "json": {
        "items": [
          {
            "id": "{{task}}",
            "state": "open"
          }
        ]
      }
    },
    {
      "id": "task-close",
      "args": [
        "contract",
        "--json",
        "--record",
        "tasks",
        "close",
        "{{task}}",
        "--as",
        "dismissed",
        "--reason",
        "synthetic-check"
      ],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "item": {
          "state": "dismissed",
          "reason": "synthetic-check"
        }
      },
      "allowSensitiveOutput": true
    },
    {
      "id": "task-persisted",
      "args": ["contract", "--json", "tasks", "list", "state:dismissed"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "allowSensitiveOutput": true,
      "json": {
        "items": [
          {
            "id": "{{task}}",
            "state": "dismissed"
          }
        ]
      }
    },
    {
      "id": "missing-task",
      "args": [
        "contract",
        "--json",
        "--trace",
        "--record",
        "tasks",
        "close",
        "missing-synthetic-task",
        "--as",
        "dismissed"
      ],
      "exit": 6,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "not_found"
    },
    {
      "id": "migration-store-repeat",
      "args": ["contract", "store", "migrate", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json"
    },
    {
      "id": "data-after-repeat",
      "args": ["contract", "--offline", "--json", "--trace", "--record", "messages", "list", "7"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "previous": false,
      "allowSensitiveOutput": true,
      "json": {
        "items": [
          {
            "id": "101",
            "text": "wirecat-synthetic-message-canary"
          }
        ]
      }
    }
  ]
}
