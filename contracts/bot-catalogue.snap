            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        ],
        "description": "the request body as JSON; - reads it from stdin"
      },
      "body_file": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "the request body from a JSON file; - is stdin"
      }
    },
    "required": [],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
