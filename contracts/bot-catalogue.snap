  "api send-message-draft": {
    "type": "object",
    "properties": {
      "chat_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Unique identifier for the target private chat"
      },
      "message_thread_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Unique identifier for the target message thread"
      },
      "draft_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Unique identifier of the message draft; must be non-zero. Changes to drafts with the same identifier are animated. Otherwise, the draft is replaced without animation."
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Text of the message to be sent, 0-4096 characters after entities parsing. Pass an empty text to show a \"Thinking...\" placeholder."
      },
      "parse_mode": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Mode for parsing entities in the message text. See formatting options for more details."
      },
      "entities": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "A JSON-serialized list of special entities that appear in message text, which can be specified instead of parse_mode"
      },
      "can_stop": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Pass True to show the user a button to stop further drafts. The bot will receive an Update \"stopped_message_generation\" if the user presses the button."
      },
      "keep_on_stop": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "Pass True to keep the draft in the chat when the button is pressed. The draft will still disappear after a short time or if the bot sends a message. To fully preserve the partial draft, the bot should send it as a new message."
      },
      "body": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        ],
        "description": "the request body as JSON; - reads it from stdin"
      },
      "body_file": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!-$)[\\s\\S]+$",
        "description": "the request body from a JSON file; - is stdin"
      }
    },
    "required": [],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
