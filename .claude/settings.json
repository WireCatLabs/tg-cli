{
  "permissions": {
    "additionalDirectories": ["/home/leemour/Projects/AI/cli-messaging", "/home/leemour/Projects/AI/cli-core"],
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm -s typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm -s lint)",
      "Bash(pnpm test)",
      "Bash(pnpm -s test)",
      "Bash(npm view *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "deny": ["Bash(sudo)", "Bash(sudo *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/writes-stay-inside.sh" }]
      }
    ]
  }
}
