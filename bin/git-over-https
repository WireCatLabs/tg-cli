#!/usr/bin/env sh
# Points tg-cli and cli-messaging at GitHub over HTTPS, with gh as the credential helper, so a push
# works inside the Bash sandbox: the sandbox does not let SSH read ~/.ssh, and `gh` reaches its token
# in the keyring over D-Bus, which the sandbox allows. Run once, outside a Claude session — the
# sandbox also keeps an agent from changing a repository's git config.
#
#   bin/git-over-https
set -eu

here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
for repo in "$main" "$(dirname "$main")/cli-messaging"; do
  git -C "$repo" remote set-url origin "https://github.com/leemour/$(basename "$repo").git"
  git -C "$repo" config credential.https://github.com.helper '!gh auth git-credential'
  echo "$(basename "$repo"): $(git -C "$repo" remote get-url origin)"
done
