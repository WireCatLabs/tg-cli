#!/usr/bin/env sh
# Prepares this Linux machine for `tg mcp --http` behind Tailscale Funnel: installs Tailscale with its
# official script, logs in (a browser link), and lets the current user run `tailscale funnel` without
# sudo. The three switches in the Tailscale admin console cannot be scripted; it prints them.
#
#   bin/tailscale-setup      # asks for your sudo password
set -eu

if ! command -v tailscale >/dev/null; then
  echo "installing Tailscale (https://tailscale.com/kb/1031/install-linux)" >&2
  curl -fsSL https://tailscale.com/install.sh | sh
fi

if ! tailscale status >/dev/null 2>&1; then
  echo "logging in — open the link Tailscale prints and sign in" >&2
  sudo tailscale up
fi

sudo tailscale set --operator="$(id -un)"

cat >&2 <<'EOF'

Now, once:
  1. If MagicDNS is off: https://console.tailscale.com/admin/dns -> MagicDNS -> Enable.
  2. Run `tailscale funnel 8765`, open the link it prints and approve. Tailscale then creates the
     HTTPS certificate and the Funnel permission itself; your machine and network names appear in
     public certificate logs (https://tailscale.com/kb/1153/enabling-https). Press Ctrl-C after.
Then run bin/tg-remote.
EOF
