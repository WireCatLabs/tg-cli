#!/usr/bin/env sh
# Starts Claude Code for one lane, in its tg-cli worktree, with no permission prompts. What keeps it
# inside: the sandbox and the hooks in .claude/ (docs/dev/agents.md). Run it from a terminal.
#
#   bin/agent l1-reading
set -eu

[ $# -eq 1 ] || { echo "usage: bin/agent <lane>" >&2; exit 2; }
lane=$1
here=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
into="$main/.worktrees/$lane"
[ -d "$into/tg-cli" ] || { echo "no lane $lane — bin/lane $lane creates it" >&2; exit 1; }
handoff="docs/lanes/$lane.md"
[ -f "$into/tg-cli/$handoff" ] || { echo "no $handoff in the lane's worktree" >&2; exit 1; }

# The owner's profile, not the default one: its login and its trusted folders are the ones that count.
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.ccs/instances/my}"
"$here/bin/trust-folder" "$into/tg-cli" "$into/cli-messaging" >/dev/null
cd "$into/tg-cli"
exec claude --permission-mode bypassPermissions --setting-sources project,local --add-dir "$into/cli-messaging" \
  "You are lane $lane. Read $handoff and follow it: it is your handoff, read instead of HANDOFF.md."
