{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@leemour/cli-core/biome"],
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!pnpm-lock.yaml", "!.claude/settings.json"]
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/telegram/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@mtcute/*", "@mtcute/**"],
                    "message": "only src/telegram/ may import mtcute; everything above it speaks the domain model from @leemour/cli-messaging"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/commands/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@mtcute/*", "@mtcute/**"],
                    "message": "only src/telegram/ may import mtcute; everything above it speaks the domain model from @leemour/cli-messaging"
                  },
                  {
                    "group": ["../telegram/map.js", "../telegram/errors.js", "**/telegram/map*", "**/telegram/errors*"],
                    "message": "commands reach Telegram through the adapter, never through its mapping or error translation"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
